# --- Database (Supabase Postgres) ---
# Use the "Session pooler" or direct connection string from your Supabase
# project settings -> Database -> Connection string (URI), driver=postgresql
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- JWT auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- SMTP email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=hello@toyospot.ng
SMTP_FROM_NAME=Toyo's Pot
SMTP_USE_TLS=true

# --- Web Push (VAPID keys - generate with `vapid --gen`, pywebpush, or web-push-libs) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:hello@toyospot.ng

# --- Supabase Storage (admin food image uploads) ---
# Project Settings -> API -> service_role key (NOT the anon key -- this
# bypasses row-level security, keep it server-side only).
# Create a public bucket named to match SUPABASE_STORAGE_BUCKET first:
# Storage -> New bucket -> "food-images" -> Public bucket.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=food-images

# --- Paystack (online payments) ---
# Dashboard -> Settings -> API Keys & Webhooks. Use test keys (sk_test_/pk_test_)
# until you're ready to go live, then swap for sk_live_/pk_live_.
# Also add {this API's URL}/webhooks/paystack as a webhook URL in that same
# dashboard page -- that's what makes payment confirmation reliable even if
# the customer's browser closes right after paying.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ADMIN_NOTIFICATION_EMAIL=admin@toyospot.ng
CORS_ORIGINS=http://localhost:5173,https://toyospot.vercel.app
